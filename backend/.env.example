# RAKSHAROVER Tactical Telemetry Server Environment Configuration

# Port to listen on (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins (Use * for all, or comma-separated list like http://localhost:3000,https://raksharover.vercel.app)
CORS_ORIGIN=*

# Set to true to serve frontend static files from backend service (useful for single-port deployments on Render/Railway)
SERVE_FRONTEND=false
